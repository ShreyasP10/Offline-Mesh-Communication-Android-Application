<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top-Left Inner Inset Dark Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/neu_inset_shadow" />
        </shape>
    </item>

    <!-- Sunken Inset Surface with Offset -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="@color/neu_inset_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_border" />
        </shape>
    </item>
</layer-list>
