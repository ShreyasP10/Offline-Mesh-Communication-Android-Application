<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inner Dark Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neu_inset_shadow" />
        </shape>
    </item>

    <!-- Sunken Inset Fill -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/neu_inset_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_dark_shadow_subtle" />
        </shape>
    </item>
</layer-list>
