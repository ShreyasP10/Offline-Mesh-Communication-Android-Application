<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Shadow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_dark_shadow" />
        </shape>
    </item>

    <!-- Light Shadow -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_light_shadow" />
        </shape>
    </item>

    <!-- Circular Surface -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_border" />
        </shape>
    </item>
</layer-list>
