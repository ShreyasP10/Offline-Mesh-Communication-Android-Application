<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/peerIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="10dp"
        android:src="@drawable/ic_mesh"
        android:contentDescription="Peer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/peerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearby Device"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/peerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ID: ABC123"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/peerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Available"
            android:textColor="#388E3C"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/connectionIndicator"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@android:drawable/presence_online"
        android:contentDescription="Connection status" />

</LinearLayout>