<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_neu_card_selectable">

    <!-- Circular Avatar with Neumorphic Elevation -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_neu_avatar">

        <ImageView
            android:id="@+id/peerIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mesh"
            android:contentDescription="Peer"
            app:tint="@color/neu_primary" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/peerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearby Device"
            android:textColor="@color/neu_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/peerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ID: ABC123"
            android:textColor="@color/neu_text_tertiary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/peerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Available"
            android:textColor="@color/neu_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/connectionIndicator"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        android:src="@android:drawable/presence_online"
        android:contentDescription="Connection status" />

</LinearLayout>